# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Nothing here is prefixed NEXT_PUBLIC_ except
# the site URL, so no secret is ever bundled into client JavaScript.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin. Drives metadataBase, canonical URLs, sitemap and OG images.
# On Vercel, set this per environment (production / preview).
NEXT_PUBLIC_SITE_URL=https://karanbhardwaj.in

# Upstream content API backing the journal.
BLOG_API_BASE=https://api.carsnbike.com/api/blog

# Google Apps Script web app URL backing the guestbook.
# Leave blank to disable the guestbook gracefully — the page still renders.
GUESTBOOK_API_URL=

# Groq. Used only by /api/ai/draft, which is author-only and rate-limited.
# Required for draft generation; everything else works without it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Author access. ADMIN_PASSPHRASE gates /studio and every journal write.
# SESSION_SECRET signs the session cookie — set it to an independent random
# value so rotating the passphrase does not require re-signing sessions, and
# so the passphrase is never used directly as a signing key.
ADMIN_PASSPHRASE=
SESSION_SECRET=

# Shared token for POST /api/revalidate, so the CMS can push a change through
# the ISR cache without an author session. Leave blank to disable that path.
REVALIDATE_TOKEN=
